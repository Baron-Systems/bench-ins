# استخدم صورة Frappe الرسمية (تقدر تغيرها لأي tag تحتاجه)
FRAPPE_IMAGE=frappe/erpnext
FRAPPE_TAG=v16.5.0

# كلمات مرور
DB_ROOT_PASSWORD=CHANGE_ME_STRONG

# Cloudflare Tunnel Token
CLOUDFLARE_TUNNEL_TOKEN=PASTE_YOUR_TOKEN_HERE

# اختياري
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m
FRAPPE_SITE_NAME_HEADER=$$host
